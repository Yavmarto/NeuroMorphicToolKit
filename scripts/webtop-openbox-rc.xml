<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal openbox config for NMTK kiosk mode.
  Placed at /defaults/.config/openbox/rc.xml so linuxserver/webtop copies
  it to ~/.config/openbox/rc.xml on container init.

  The <application> rule with class="*" forces every window fullscreen,
  which is correct for a single-app kiosk. Remove or restrict the rule
  if you ever add a multi-window mode.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc"
                xmlns:xi="http://www.w3.org/2001/XInclude">

  <resistance><strength>10</strength><screen_edge_strength>20</screen_edge_strength></resistance>
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse><focusDelay>200</focusDelay></focus>
  <placement><policy>Smart</policy></placement>

  <keyboard>
    <!-- Allow Alt+F4 as the only escape hatch from the kiosk -->
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>

  <mouse>
    <dragThreshold>1</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <screenEdgeWarpTime>400</screenEdgeWarpTime>
  </mouse>

  <applications>
    <!-- Force every window fullscreen — kiosk rule.
         decor:no  — prevents title-bar reappearing if app exits fullscreen.
         desktop:1 — pins to workspace 1 regardless of XFCE workspace state. -->
    <application class="*">
      <fullscreen>yes</fullscreen>
      <focus>yes</focus>
      <decor>no</decor>
      <desktop>1</desktop>
    </application>
  </applications>

</openbox_config>
