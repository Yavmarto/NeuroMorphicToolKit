#ifndef LIF_ENGINE_H
#define LIF_ENGINE_H

#include "network_params.h"
#include <string.h>

// Neuron state arrays
float voltage[NUM_NEURONS];
bool spiked[NUM_NEURONS];
float input_currents[NUM_INPUTS];
float output_spikes[NUM_OUTPUTS];
bool spike_history[MAX_DELAY_STEPS + 1][NUM_NEURONS];
int delay_cursor = 0;

// LIF parameters
static const float V_RESET = {{ v_reset | default(0.0) }}f;

int refractory_counter[NUM_NEURONS];

void initialize_network() {
    memset(voltage, 0, sizeof(voltage));
    memset(spiked, 0, sizeof(spiked));
    memset(refractory_counter, 0, sizeof(refractory_counter));
    memset(input_currents, 0, sizeof(input_currents));
    memset(output_spikes, 0, sizeof(output_spikes));
    memset(spike_history, 0, sizeof(spike_history));
    delay_cursor = 0;
}

void step_network(float* external_input) {
    // Reset spike flags
    memset(spiked, 0, sizeof(spiked));

    // Inject external input into input population neurons
    for (int i = 0; i < NUM_INPUTS; i++) {
        voltage[input_neuron_ids[i]] += external_input[i];
    }

    // Propagate spikes through synapses (from previous timestep)
    for (int s = 0; s < NUM_SYNAPSES; s++) {
        int pre = synapse_pre[s];
        int post = synapse_post[s];
        int source_slot =
            (delay_cursor - (synapse_delay_steps[s] - 1) + (MAX_DELAY_STEPS + 1)) % (MAX_DELAY_STEPS + 1);
        if (spike_history[source_slot][pre]) {
            // Cast weight from quantized storage
            {% if bit_width <= 8 %}
            float w = ((float)weights[s]) / {{ (2 ** (bit_width - 1)) - 1 }}.0f;
            {% else %}
            float w = weights[s];
            {% endif %}
            voltage[post] += w;
        }
    }

    // LIF update for each neuron
    for (int i = 0; i < NUM_NEURONS; i++) {
        if (refractory_counter[i] > 0) {
            refractory_counter[i]--;
            voltage[i] = V_RESET;
            continue;
        }

        // Leaky integration: decay toward reset
        voltage[i] = V_RESET + tau_values[i] * (voltage[i] - V_RESET);

        // Threshold check
        if (voltage[i] >= thresholds[i]) {
            spiked[i] = true;
            voltage[i] = V_RESET;
            refractory_counter[i] = refractory_steps[i];
        }
    }

    delay_cursor = (delay_cursor + 1) % (MAX_DELAY_STEPS + 1);
    memset(spike_history[delay_cursor], 0, sizeof(spike_history[delay_cursor]));
    for (int i = 0; i < NUM_NEURONS; i++) {
        spike_history[delay_cursor][i] = spiked[i];
    }

    // Copy output neuron spikes
    for (int i = 0; i < NUM_OUTPUTS; i++) {
        output_spikes[i] = spiked[output_neuron_ids[i]] ? 1.0f : 0.0f;
    }
}

#endif // LIF_ENGINE_H
