# NeuroMorphicToolkit (NMTK) Environment Configuration
# Copy this file to .env and adjust as needed

# --- Service Ports ---
# These ports are used by the host to access services and by docker-compose for mapping
NEUROCNL_PORT=8000
NEUROSIM_PORT=8001
NEUROCHIP_PORT=8002
NEUROBENCH_PORT=8003
NEUROSENSE_PORT=8004
NEUROHUB_PORT=8005
NEUROCNL_PHYSICS_PORT=8006
SUITE_API_PORT=9000

# --- Inter-Service Communication (Within Docker Network) ---
# Used by Neurohub to orchestrate and communicate with other modules
NEUROCNL_URL=http://neurocnl:8000
NEUROSIM_URL=http://neurosim:8000
NEUROCHIP_URL=http://neurochip:8000
NEUROBENCH_URL=http://neurobench:8000
NEUROSENSE_URL=http://neurosense:8000

# --- Frontend Configuration ---
# The base URL the frontend should use to connect to its backend API
# This is typically set during build time for Flutter web
API_BASE_URL=http://localhost:8000

# --- Database Configuration ---
# Connection string for Neurohub database (default is local SQLite)
# DATABASE_URL=sqlite:///./neurohub.db
# DATABASE_URL=postgresql://user:password@localhost/dbname

# --- Storage Configuration ---
# Path for shared assets across the suite
SHARED_STORAGE_PATH=./shared_assets

# Path for NeuroSense recordings
NEUROSENSE_RECORDINGS_DIR=recordings

# --- Hardware Configuration (Neuro-Dream-Hand) ---
NDH_SERIAL_PORT=/dev/ttyACM0
NDH_SERIAL_BAUD=115200

# --- External Services ---
# Required for some neurocnl generation features
# ANTHROPIC_API_KEY=your_key_here

# --- Security & Auth ---
# Grafana dashboard admin password. Required when running the monitoring profile.
# Generate a value: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=changeme_replace_before_running

# suite_api allowed CORS origins (comma-separated).
# Defaults to localhost-only. Override for your deployment.
# ALLOWED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:3000

# Neurohub JWT signing key. REQUIRED in production (ENVIRONMENT=production).
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# NEUROHUB_SECRET_KEY=

# --- Docker / Deployment Settings ---
# PYTHONUNBUFFERED=1
# PYTHONOPTIMIZE=1
