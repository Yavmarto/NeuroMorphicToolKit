[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ task }} SNN project — NIR + Lava simulator"
requires-python = ">=3.10"
dependencies = [
    "nir>=1.0.0",
    "numpy>=1.24.0",
]

[project.optional-dependencies]
lava = ["lava-nc>=0.5.0"]
dev = ["pytest>=8.0.0"]
