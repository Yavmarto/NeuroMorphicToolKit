[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ task }} SNN project — NIR + SC-NeuroCore (Rust) simulator"
requires-python = ">=3.10"
dependencies = [
    "nir>=1.0.0",
    "sc-neurocore>=3.13.0,<4",
    "numpy>=1.24.0",
]

[project.optional-dependencies]
dev = ["pytest>=8.0.0"]
