[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ task }} SNN project — NeuroCNL + NeuroSim canvas simulation"
requires-python = ">=3.10"
dependencies = ["nir>=1.0.0", "httpx>=0.27.0"]

[project.optional-dependencies]
dev = ["pytest>=8.0.0"]
