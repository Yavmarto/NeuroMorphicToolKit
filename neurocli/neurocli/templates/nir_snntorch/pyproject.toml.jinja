[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ task }} SNN project — NIR + snnTorch simulator"
requires-python = ">=3.10"
dependencies = [
    "nir>=1.0.0",
    "snntorch>=0.9.0",
    "torch>=2.0.0",
    "numpy>=1.24.0",
    "tonic>=1.4.0",
    "jupytext>=1.15.0",
    "jupyterlab>=4.0.0",
]

[project.optional-dependencies]
dev = ["pytest>=8.0.0"]
