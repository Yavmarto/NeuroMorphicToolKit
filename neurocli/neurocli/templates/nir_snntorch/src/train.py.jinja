from __future__ import annotations

import torch
from torch.utils.data import DataLoader
import snntorch as snn
try:
    import nir
    import nirtorch
    from neurocnl.compiler import compile_to_nir
except ImportError as exc:
    print(f"Missing dependency: {exc}. Run `uv sync` first.")

# %% [markdown]
# ## 1. Define Architecture (CNL to NIR)
# We define the abstract neuromorphic architecture using CNL, then compile it to a NIR graph.

# %%
CNL_SPEC = """
Define a network named {{ project_name }}.

Define an input port named input with shape (1,).
Define a leaky integrate-and-fire neuron named sensor with time constant 0.02, resistance 1.0, leak voltage 0.0, and firing threshold 1.0.
Define a linear transformation named w1 with weight matrix shape (1, 1) and weight matrix values (1.0,).
Define an output port named output with shape (1,).

input connects to sensor.
sensor connects to w1.
w1 connects to output.
"""

nir_graph = compile_to_nir(CNL_SPEC)
print("✓ NIR Graph compiled from CNL")

# %% [markdown]
# ## 2. Convert to Training Framework
# We convert the NIR graph into a standard PyTorch `nn.Module` using `nirtorch`.

# %%
model = nirtorch.from_nir(nir_graph)
print(model)

# %% [markdown]
# ## 3. Dataloading
# Since the model is just a PyTorch Module, we can use standard Dataloaders or Tonic.

# %%
# TODO: Replace with your actual dataset
# For event-based data, consider using Tonic: `import tonic`
batch_size = 32
# dummy data: (batch, time_steps, features)
dummy_dataset = [(torch.rand(10, 1), torch.tensor(0)) for _ in range(100)]
dataloader = DataLoader(dummy_dataset, batch_size=batch_size, shuffle=True)

# %% [markdown]
# ## 4. Training Loop (BPTT with Surrogate Gradients)

# %%
optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)
loss_fn = torch.nn.CrossEntropyLoss()

num_epochs = 2
for epoch in range(num_epochs):
    for data, targets in dataloader:
        optimizer.zero_grad()
        
        # snnTorch simulation over time
        spk_rec = []
        mem_rec = []
        # In a real model, you'd iterate over time steps
        for step in range(data.size(1)):
            spk, mem = model(data[:, step])
            spk_rec.append(spk)
            mem_rec.append(mem)
            
        spk_rec = torch.stack(spk_rec, dim=0)
        
        # Calculate loss on output spikes
        loss = loss_fn(spk_rec.sum(dim=0), targets)
        loss.backward()
        optimizer.step()
        
    print(f"Epoch {epoch+1}/{num_epochs} - Loss: {loss.item():.4f}")

