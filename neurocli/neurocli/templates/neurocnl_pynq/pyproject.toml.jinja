[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ task }} SNN project — NeuroCNL + PYNQ-Z2 deployment"
requires-python = ">=3.10"
dependencies = ["nir>=1.0.0"]

[project.optional-dependencies]
pynq = ["pynq>=3.0.0"]
dev = ["pytest>=8.0.0"]
