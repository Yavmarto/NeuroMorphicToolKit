# Dedicated Lava worker image.
#
# lava-nc (latest 0.10.0) requires Python >=3.10,<3.11, so this image stays on
# Python 3.10. The Neurochip project itself requires >=3.11, so the Lava
# runtime is vendored here via workers/lava_backend/requirements.txt instead of
# a `poetry install --extras lava` on Neurochip — that extra can never resolve.
FROM python:3.14-slim

WORKDIR /app

COPY workers/lava_backend/requirements.txt /app/workers/lava_backend/requirements.txt
RUN pip install --no-cache-dir -r /app/workers/lava_backend/requirements.txt \
 && pip install --no-cache-dir prometheus-client

# Neurochip source + the shared nmtk_contracts package (a path dependency of
# Neurochip that requires Python >=3.11, so it is resolved on PYTHONPATH here
# instead of pip-installed into this 3.10 image).
COPY Neurochip/neurochip /app/Neurochip/neurochip
COPY nmtk_contracts/nmtk_contracts /app/nmtk_contracts/nmtk_contracts
COPY nmtk/__init__.py /app/nmtk/__init__.py
COPY nmtk/metrics_core.py /app/nmtk/metrics_core.py
COPY nmtk/http_metrics.py /app/nmtk/http_metrics.py
COPY workers/lava_backend /app/workers/lava_backend

ENV PYTHONPATH="/app/Neurochip:/app/workers/lava_backend:/app/nmtk_contracts:/app"

RUN groupadd --system appgroup && useradd --system --gid appgroup appuser \
 && chown -R appuser:appgroup /app
USER appuser

CMD ["uvicorn", "main:app", "--app-dir", "/app/workers/lava_backend", "--host", "0.0.0.0", "--port", "8012"]
