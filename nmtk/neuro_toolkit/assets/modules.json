      },
      "akida": {
        "runtimePort": 8002,
        "controlPort": 8091,
        "sshPort": 22,
        "defaultState": "unknown",
        "defaultAuthMode": "password",
        "installRoot": "/opt/neurochip-akida-host",
        "serviceUser": "neurochip",
        "venvDirName": "venv",
        "runtimeServiceName": "neurochip",
        "controlServiceName": "neurochip-akida-control",
        "tokenRelativePath": "credentials/api-token",
        "installStatusRelativePath": "install-status.json"
      }
    },
    "hasFrontend": true,
    "frontendStatus": "Yes",
    "requiresMuJoCo": false,
    "remoteUrl": "https://api.github.com/repos/Completed-Spoon-6/Neurochip",
